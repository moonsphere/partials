#!/usr/bin/env python3
"""Evaluate Clojure in the running nREPL (started by bin/repl).

    bin/eval "(play! 'op00)"
    bin/eval -n partials.pieces.op00-tuning "(play)"
    bin/eval < sketch.clj

Prints *out*, *err* and each value; exits 1 if evaluation threw.
"""
import argparse
import os
import socket
import sys
import uuid

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))


def encode(x):
    if isinstance(x, int):
        return b"i%de" % x
    if isinstance(x, str):
        x = x.encode()
    if isinstance(x, bytes):
        return b"%d:%s" % (len(x), x)
    if isinstance(x, list):
        return b"l" + b"".join(map(encode, x)) + b"e"
    if isinstance(x, dict):
        return b"d" + b"".join(encode(k) + encode(v) for k, v in sorted(x.items())) + b"e"
    raise TypeError(type(x))


def decode(f):
    c = f.read(1)
    if not c:
        raise EOFError("nREPL closed the connection")
    if c == b"i":
        return int(_until(f, b"e"))
    if c == b"l":
        items = []
        while (item := _peek_decode(f)) is not _END:
            items.append(item)
        return items
    if c == b"d":
        d = {}
        while (k := _peek_decode(f)) is not _END:
            d[k] = decode(f)
        return d
    n = int(c + _until(f, b":"))
    return f.read(n).decode(errors="replace")


_END = object()


def _peek_decode(f):
    if f.peek(1)[:1] == b"e":
        f.read(1)
        return _END
    return decode(f)


def _until(f, stop):
    buf = b""
    while (c := f.read(1)) != stop:
        buf += c
    return buf


def main():
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("code", nargs="?", help="code to evaluate (default: stdin)")
    p.add_argument("-n", "--ns", default="partials.studio")
    p.add_argument("-p", "--port", type=int)
    args = p.parse_args()

    code = args.code if args.code is not None else sys.stdin.read()
    port = args.port
    if port is None:
        try:
            with open(os.path.join(ROOT, ".nrepl-port")) as f:
                port = int(f.read().strip())
        except FileNotFoundError:
            sys.exit("no .nrepl-port — start the REPL with bin/repl first")

    msg_id = str(uuid.uuid4())
    failed = False
    with socket.create_connection(("127.0.0.1", port)) as s:
        s.sendall(encode({"op": "eval", "code": code, "ns": args.ns, "id": msg_id}))
        f = s.makefile("rb")
        while True:
            resp = decode(f)
            if resp.get("id") != msg_id:
                continue
            if "out" in resp:
                sys.stdout.write(resp["out"])
            if "err" in resp:
                sys.stderr.write(resp["err"])
            if "value" in resp:
                print(resp["value"])
            if "ex" in resp:
                failed = True
            status = resp.get("status", [])
            if "namespace-not-found" in status:
                sys.exit(f"namespace not found: {args.ns}")
            if "done" in status:
                break
    sys.exit(1 if failed else 0)


if __name__ == "__main__":
    main()
